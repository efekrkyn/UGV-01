  (text "P0 REVIEW SHEET - NOT FOR FABRICATION; not a functional-safety certification." (exclude_from_sim no) (at 406.4 284.48 0)
    (effects (font (size 1.27 1.27)) (justify left)) (uuid "1ff377fb-eccc-597f-b207-469a90343b4b"))
  (text "CHAIN_OK = NC_A AND NC_B AND WD_OK; WD_OK = TPS3431 WDO AND ENOUT (wired); TPS3808 RAIL_OK drives TPS3431 EN." (exclude_from_sim no) (at 406.4 289.56 0)
    (effects (font (size 1.27 1.27)) (justify left)) (uuid "3b8bf291-2417-5427-933f-08d57847dab8"))
  (text "SAFE_GATE = LATCH_OK AND CHAIN_OK AND MCU_RUN_REQ. Latch sets only on reset-button release with CHAIN_OK High." (exclude_from_sim no) (at 406.4 294.64 0)
    (effects (font (size 1.27 1.27)) (justify left)) (uuid "d4f69d1a-f81e-583b-9052-de4e22a8ac84"))
  (text "NC-A carries K1 coil energy; NC-B powers the LVC1T45 B side (K2 EN, precharge, test permit). Logic cannot veto an open NC." (exclude_from_sim no) (at 406.4 299.72 0)
    (effects (font (size 1.27 1.27)) (justify left)) (uuid "312357c3-2fed-53b6-9c7b-4eed532e974d"))
  (text "LM74900 SLEEP is not an E-stop: SLEEP=EN=SAFE_EN, driven Low by hardware. K2_FLT is read by MCU only (latch input OPEN)." (exclude_from_sim no) (at 406.4 304.8 0)
    (effects (font (size 1.27 1.27)) (justify left)) (uuid "8925534b-7a87-5cdc-818f-3369477050e2"))
  (text "J-ESTOP, PTC, TVS MPNs OPEN. T01/T03/T13 physical evidence NOT_RUN." (exclude_from_sim no) (at 406.4 309.88 0)
    (effects (font (size 1.27 1.27)) (justify left)) (uuid "bd7f2eb1-ba8b-509f-b679-b01ae19a40b0"))
